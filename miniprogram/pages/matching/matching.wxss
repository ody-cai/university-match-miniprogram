/* ============================================================
   匹配中（04）
   中部内容垂直居中：吉祥物 132 + 标题文案 + 阶段指示 + 进度卡
   ============================================================ */
.matching {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.matching__main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 32px;
}

/* ---------------- 文案区 ---------------- */
.matching__text {
  margin-top: 30px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.matching__title {
  font-size: 22px;
  font-weight: 700;
  color: var(--t1);
  letter-spacing: 0.2px;
}
.matching__caption {
  margin-top: 10px;
  font-size: 15px;
  color: var(--t2);
  line-height: 1.5;
  min-height: 22px;
}

/* ---------------- 阶段指示 ----------------
   4 个胶囊：已完成=浅蓝，当前=钴蓝拉长，未开始=灰 */
.matching__steps {
  display: flex;
  align-items: center;
  margin-top: 16px;
}
.mstep {
  width: 8px;
  height: 8px;
  margin: 0 4px;
  border-radius: 100px;
  background: #d3e0f2;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.mstep--done {
  background: var(--brand-tint);
}
.mstep--on {
  width: 22px;
  background: var(--brand);
}

/* ---------------- 进度卡 ---------------- */
.matching__card {
  width: 100%;
  margin-top: 30px;
  padding: 16px;
  border-radius: 16px;
  background: #ffffff;
  border: 1px solid var(--line);
}
.matching__card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}
.matching__label {
  font-size: 14px;
  font-weight: 500;
  color: var(--t1);
}
.matching__pct {
  font-size: 14px;
  font-weight: 700;
  color: var(--brand);
  font-variant-numeric: tabular-nums;
}
.matching__foot {
  display: block;
  margin-top: 10px;
  font-size: 12px;
  color: var(--t3);
}

/* 进度条：数值来自真实阶段，宽度用 0.35s 过渡而非逐帧重绘 */
.matching__card .bar__fill {
  transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
