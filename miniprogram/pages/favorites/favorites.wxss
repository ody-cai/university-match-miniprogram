/* ============================================================
   我的收藏（11）
   二级页（navigateTo，无标签栏）：只有统计条 + 收藏列表 + 空态。
   行样式在 components/school-row/index.wxss，本文件只管页面容器与空态。
   ============================================================ */

.fav {
  padding: 10px 16px 0;
}

/* ---------------- 统计 ---------------- */
.fav__bar {
  display: flex;
  align-items: center;
  margin: 0 2px 10px;
}
.fav__total {
  font-size: 13px;
  color: var(--t3);
}

/* ---------------- 空态 ----------------
   尚未收藏任何院校时展示，并给出「去院校库」的出口 ——
   空页面只写一句「还没有收藏」而不给下一步，用户只能自己点返回。 */
.fav__empty {
  padding: 64px 24px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.fav__empty-title {
  margin-top: 14px;
  font-size: 15px;
  font-weight: 600;
  color: var(--t2);
}
.fav__empty-hint {
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.6;
  color: var(--t3);
  text-align: center;
}
.fav__empty-btn {
  margin-top: 22px;
  width: 100%;
  max-width: 260px;
}
